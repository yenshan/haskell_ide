{
  "name": "kata-haskell",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet workspace for Haskell practice",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/core.test.cjs",
    "test:electron": "npm run build && electron tests/electron-smoke.cjs",
    "check": "tsc --noEmit",
    "postinstall": "node scripts/prepare-pty.cjs",
    "prestart": "node scripts/prepare-pty.cjs",
    "predev": "node scripts/prepare-pty.cjs",
    "pretest": "node scripts/prepare-pty.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.1",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
